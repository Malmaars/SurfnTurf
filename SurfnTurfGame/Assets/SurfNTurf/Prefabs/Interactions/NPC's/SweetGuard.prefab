    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[0]'
      value: 'Halt! '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[1]'
      value: 'Who stands before the sacred domain of the god of sweetness. '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[2]'
      value: 'Only those who have permission may enter. '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[3]'
      value: None will slip by me.
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[4]'
      value: "I guard this place with all my attention. Nothing shall\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[5]'
      value: 'ahem. Nothing shall tempt me. '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[6]'
      value: "Unless\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[7]'
      value: you happen to have something made with my favorite ingredient.
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[8]'
      value: 'I have not tasted the sweetness in a long time. '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[9]'
      value: "Ahum\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[10]'
      value: "Ahum\u2026 Could you bring me a dish with honeyberries"
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[11]'
      value: 'and maybe, just maybe i will let you in? '
      objectReference: {fileID: 0}
    - target: {fileID: 3290039904537624143, guid: e4d7cbca6a9615e499283407e44e6998, type: 3}
      propertyPath: 'convos.Array.data[0].sentences.Array.data[12]'
      value: Now off with you!
      objectReference: {fileID: 0}
