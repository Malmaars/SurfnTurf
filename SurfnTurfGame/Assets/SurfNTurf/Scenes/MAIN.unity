    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: convo.sentences.Array.size
      value: 13
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[0]'
      value: 'Halt! '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[1]'
      value: 'Who stands before the sacred domain of the god of sweetness. '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[2]'
      value: 'Only those who have permission may enter. '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[3]'
      value: None will slip by me.
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[4]'
      value: "I guard this place with all my attention. Nothing shall\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[5]'
      value: 'ahem. Nothing shall tempt me. '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[6]'
      value: "Unless\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[7]'
      value: you happen to have something made with my favorite ingredient.
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[8]'
      value: 'I have not tasted the sweetness in a long time. '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[9]'
      value: "Ahum\u2026 "
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[10]'
      value: "Ahum\u2026 Could you bring me a dish with honeyberries"
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[11]'
      value: 'and maybe, just maybe i will let you in? '
      objectReference: {fileID: 0}
    - target: {fileID: 4232832566934447197, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
      propertyPath: 'convo.sentences.Array.data[12]'
      value: Now off with you!
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 66e5d234c98ac1646acd0e5a1aab2f8d, type: 3}
